# 复制为 .env 后按需修改。生产环境必须改 SECRET_KEY。
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
SECRET_KEY=change-me-to-a-long-random-string
SERVER_NAME=未读
PUBLIC_BASE_URL=http://127.0.0.1:8000
MIN_APP_VERSION=1.0.0
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
# 能力网关配置（可选）。复制 gateway.yaml.example 为 gateway.yaml
# GATEWAY_CONFIG=./gateway.yaml
# DSH 主脑（唯一思考环，无本地 LLM 回退）
# AI 主机: systemd chat-dsh-gateway；本机: ./dsh-product/scripts/ensure-dsh-tunnel.sh
DSH_GATEWAY_ENABLED=1
DSH_GATEWAY_URL=http://127.0.0.1:8787
DSH_GATEWAY_TOKEN=change-me

# —— 公网穿透（没公网 IP / 没跳板时选一个免费方案）——
# none | cloudflared | ngrok | localhost_run | pinggy | ssh_jump
# 推荐试用：cloudflared（免账号，需安装 cloudflared）
PUBLIC_TUNNEL_PROVIDER=none
# 为 1 时随 uvicorn 自动启动穿透；也可手动：python scripts/tunnel_ctl.py start cloudflared
PUBLIC_TUNNEL_AUTOSTART=0
# ngrok 免费档需要 authtoken：https://dashboard.ngrok.com/get-started/your-authtoken
# PUBLIC_TUNNEL_NGROK_AUTHTOKEN=
# Cloudflare 具名隧道 token（可选；不填则用临时 trycloudflare.com）
# PUBLIC_TUNNEL_CLOUDFLARED_TOKEN=
# 自建跳板（你现在的腾讯云方案）
# PUBLIC_TUNNEL_SSH_CONFIG=/path/to/ssh-config
# PUBLIC_TUNNEL_SSH_HOST=local-ai-public
# PUBLIC_TUNNEL_SSH_REMOTE_PORT=8000

# —— P3 虚拟电脑 ——
# mock（默认，本地/CI）| docker_novnc（隔离 XFCE 容器）| aio_sandbox
# 生产用 docker_novnc；勿用 host_x11（会控 AI 主机真桌面）
DESKTOP_BACKEND=mock
# DESKTOP_DOCKER_IMAGE=consol/ubuntu-xfce-vnc
# DESKTOP_NOVNC_HOST_PORT=16083
# DESKTOP_PUBLIC_PATH=/vd/desktop/
# DESKTOP_RESOLUTION=1280x800
# ANDROID_DOCKER_IMAGE=redroid/redroid:13.0.0-latest
# ANDROID_NOVNC_HOST_PORT=16082
# DESKTOP_AIO_BASE_URL=http://127.0.0.1:8080
# DESKTOP_AIO_TOKEN=

# 腾讯位置 WebService（逆地理/周边）；勿提交真实 Key
# TENCENT_MAP_KEY=
